# The container must listen on all interfaces inside Docker.
HOST=0.0.0.0
PORT=8787
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9010

# NapCat runs outside this container. On Docker Desktop use host.docker.internal.
# On Linux, this name is provided by docker-compose extra_hosts.
NAPCAT_API_URL=http://host.docker.internal:3000
NAPCAT_TOKEN=
NAPCAT_OPEN_AUTH_PLUGIN_URL=http://host.docker.internal:6099/plugin/qq-miniapp-openauth/api
NAPCAT_OPEN_AUTH_PLUGIN_TOKEN=
NAPCAT_WEBUI_API_URL=http://host.docker.internal:6099/api
NAPCAT_WEBUI_TOKEN=
NAPCAT_WEBUI_CREDENTIAL=
NAPCAT_WEBUI_CONFIG=
NAPCAT_QR_IMAGE_PATH=

# The Web container and its bridge share the same Docker network namespace.
# Run exactly one container replica because the NapCat workflow lock is in memory.
BRIDGE_URL=http://127.0.0.1:9010
BRIDGE_TOKEN=
BRIDGE_MINIAPP_START_PATH=/api/miniapp/login/start
BRIDGE_MINIAPP_STATUS_PATH=/api/miniapp/login/status
BRIDGE_MINIAPP_CANCEL_PATH=/api/miniapp/login/cancel
BRIDGE_LOGOUT_PATH=/api/qq/logout
WORKFLOW_TTL_MS=120000
TASK_TTL_MS=120000
API_SIGNING_SECRET=qq-miniapp-auth-default-signing-secret
CORS_ORIGIN=same-origin
MINIAPP_SECRETS={}

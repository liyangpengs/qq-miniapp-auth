# Web server
PORT=8787
HOST=127.0.0.1

# NapCat OneBot HTTP server. Keep this bound to localhost or a private network.
NAPCAT_API_URL=http://127.0.0.1:3000
NAPCAT_TOKEN=
NAPCAT_OPEN_AUTH_PLUGIN_URL=http://127.0.0.1:6099/plugin/qq-miniapp-openauth/api
NAPCAT_OPEN_AUTH_PLUGIN_TOKEN=

# Set a token/credential, or point at NapCat's config/webui.json and the token is discovered automatically.
NAPCAT_WEBUI_API_URL=http://127.0.0.1:6099/api
NAPCAT_WEBUI_TOKEN=
NAPCAT_WEBUI_CREDENTIAL=
NAPCAT_WEBUI_CONFIG=
# Optional fallback: an absolute path to NapCat's generated cache/qrcode.png.
# Use this when WebUI token auth is unavailable.
NAPCAT_QR_IMAGE_PATH=

# Local HTTP bridge implemented in this project.
BRIDGE_URL=http://127.0.0.1:9010
# Optional bridge bearer token. If set, use the same value for Web and bridge.
BRIDGE_TOKEN=
BRIDGE_MINIAPP_START_PATH=/api/miniapp/login/start
BRIDGE_MINIAPP_STATUS_PATH=/api/miniapp/login/status
BRIDGE_MINIAPP_CANCEL_PATH=/api/miniapp/login/cancel
BRIDGE_LOGOUT_PATH=/api/qq/logout
WORKFLOW_TTL_MS=120000
TASK_TTL_MS=120000

# Fixed value required in the X-API-Signature header for the four public API operations.
# /api/health does not require this header. Change this value in production.
API_SIGNING_SECRET=qq-miniapp-auth-default-signing-secret

# Bridge server
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9010

# Leave as same-origin when cross-origin browser calls are not needed. Set an
# explicit origin when calling the API from another site, for example https://auth.example.com.
CORS_ORIGIN=same-origin
NAPCAT_OPEN_AUTH_TIMEOUT_MS=45000

# Optional JSON map used by /api/miniapp/exchange, for example:
# {"wx123":"secret-value"}
MINIAPP_SECRETS={}
